# ---------------------------------------------------------------------------
# Copy to `.env.local` for the dev server, and set these as SERVER-side
# environment variables in your hosting provider's dashboard.
#
# NEVER prefix these with VITE_. Vite inlines every `VITE_*` variable into the
# client bundle at build time, which publishes the secret to every visitor.
# ---------------------------------------------------------------------------

# Required N8n webhook that receives contact submissions. Server-side only.
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/xxxxx

# Required shared secret. Set the same value on the N8n Webhook node's
# header-auth so only your own function can trigger the workflow.
N8N_WEBHOOK_SECRET=change-me

# Comma-separated list of origins allowed to POST to /api/contact.
# Required in production. Include localhost:3000 for local Vite development.
ALLOWED_ORIGINS=https://persona-website-mlux.vercel.app,http://localhost:3000

# Optional shared rate limiting (5 requests/minute per IP). If either value is
# absent, api/contact.ts falls back to its per-instance in-memory limiter.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
