# ---------------------------------------------------------------------------
# Copy to `.env.local` for the dev server, and set these as SERVER-side
# environment variables in your hosting provider's dashboard.
#
# NEVER prefix these with VITE_. Vite inlines every `VITE_*` variable into the
# client bundle at build time, which publishes the secret to every visitor.
# ---------------------------------------------------------------------------

# N8n webhook that receives contact submissions. Server-side only (api/contact.ts).
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/xxxxx

# Optional shared secret. Set the same value on the N8n Webhook node's
# header-auth so only your own function can trigger the workflow.
N8N_WEBHOOK_SECRET=change-me

# Comma-separated list of origins allowed to POST to /api/contact.
# Empty = accept any origin (weak, but easier for local testing).
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:3000